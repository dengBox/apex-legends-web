{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apex-legends-web",
  "version": "0.1.0",
  "identifier": "com.apex-legends-web.app",
  "build": {
    "beforeDevCommand": "pnpm build",
    "devUrl": "http://localhost:2999",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "apex-legends-web",
        "url": "",
        "width": 1000,
        "height": 600,
        "fullscreen": false,
        "resizable": true,
        "x": 0,
        "y": 0,
        "additionalBrowserArgs": "--enable-unsafe-webgpu --use-angle=gl"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
